<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 bar: mirror WiFi-VPN widget_status_4x1 structure (content left, action button right). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="@color/md_theme_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_status_ready"
                android:textColor="@color/status_ok"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_last_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_last_sync_none"
            android:textColor="@color/status_off"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_changes_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_changes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_changes_placeholder"
            android:textColor="@color/md_theme_on_surface"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Identical to WiFi-VPN widgetToggle (Start/Stop) TextView. -->
    <TextView
        android:id="@+id/widget_sync_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="@string/widget_sync"
        android:textColor="@color/md_theme_on_primary_container"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
